<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexora.Installer.MainWindow" Title="Nexora — Installation" Width="1020" Height="760" MinWidth="850" MinHeight="620" CanResize="True" WindowStartupLocation="CenterScreen" Icon="avares://Nexora-Setup/Assets/Nexora_Icon.png">
  <Grid RowDefinitions="76,*,80">
    <Border Background="White" BorderBrush="#DCE3EE" BorderThickness="0,0,0,1" Padding="26,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="avares://Nexora-Setup/Assets/Nexora_Icon.png" Width="42" Height="42"/>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center" Spacing="2"><TextBlock Text="NEXORA" FontSize="19" FontWeight="Bold"/><TextBlock Text="Assistant d’installation" Classes="muted"/></StackPanel>
        <Border Grid.Column="2" Background="#EDF3FF" CornerRadius="6" Padding="13,8" VerticalAlignment="Center"><TextBlock x:Name="VersionBadge" Foreground="#2559C7" FontSize="12" FontWeight="SemiBold"/></Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="224,*">
      <Border Background="#12233F" Padding="20,30">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="8,20,8,0"><TextBlock Text="VOTRE ESPACE, VOS DONNÉES" Foreground="#B4C8EA" FontSize="10" FontWeight="Bold"/><TextBlock Text="Installation pour votre compte Windows. Les données du coffre sont conservées." Foreground="#BBC9DF" FontSize="12"/></StackPanel>
          <StackPanel Spacing="12">
            <TextBlock Text="INSTALLER NEXORA" Foreground="#8FA9D2" FontSize="11" FontWeight="Bold" Margin="10,0,0,16"/>
            <Border x:Name="NavStep0" CornerRadius="7" Padding="13"><TextBlock x:Name="NavText0" Text="01   Bienvenue" Foreground="White"/></Border>
            <Border x:Name="NavStep1" CornerRadius="7" Padding="13"><TextBlock x:Name="NavText1" Text="02   Vérifications" Foreground="#BBC9DF"/></Border>
            <Border x:Name="NavStep2" CornerRadius="7" Padding="13"><TextBlock x:Name="NavText2" Text="03   Configuration" Foreground="#BBC9DF"/></Border>
            <Border x:Name="NavStep3" CornerRadius="7" Padding="13"><TextBlock x:Name="NavText3" Text="04   Installation" Foreground="#BBC9DF"/></Border>
            <Border x:Name="NavStep4" CornerRadius="7" Padding="13"><TextBlock x:Name="NavText4" Text="05   Résultat" Foreground="#BBC9DF"/></Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,30,34,28">
          <StackPanel x:Name="WelcomePage" Spacing="20">
            <TextBlock Text="Installez Nexora en confiance." Classes="heading"/>
            <TextBlock Text="Un parcours guidé pour préparer votre environnement et installer votre clé de sécurité virtuelle." Foreground="#52647C" FontSize="16"/>
            <Border Classes="card" Margin="0,8,0,0"><StackPanel Spacing="20">
              <StackPanel Spacing="5"><TextBlock Text="01   Vérifier avant de commencer" FontWeight="SemiBold"/><TextBlock Text="Système, intégrité du paquet, espace libre, accès au dossier et prérequis USB/IP." Classes="muted"/></StackPanel>
              <StackPanel Spacing="5"><TextBlock Text="02   Choisir vos options" FontWeight="SemiBold"/><TextBlock Text="Dossier d’installation, raccourcis et démarrage à l’ouverture de session." Classes="muted"/></StackPanel>
              <StackPanel Spacing="5"><TextBlock Text="03   Installer et contrôler" FontWeight="SemiBold"/><TextBlock Text="Les fichiers sont vérifiés avant et après leur copie. Le coffre n’est ni remplacé ni migré." Classes="muted"/></StackPanel>
            </StackPanel></Border>
            <TextBlock Text="Windows 64 bits · Installation par utilisateur · Application autonome, sans installation séparée de .NET." Classes="muted"/>
          </StackPanel>
          <StackPanel x:Name="DiagnosticPage" IsVisible="False" Spacing="14">
            <TextBlock Text="Vérifier votre environnement" Classes="heading"/>
            <TextBlock Text="Les points bloquants doivent être résolus avant de continuer. Aucun fichier de l’application n’est installé pendant ce contrôle." Classes="muted"/>
            <Border Classes="card"><StackPanel Spacing="13">
              <TextBlock x:Name="WindowsStatus" Text="Windows : en attente"/><TextBlock x:Name="ArchStatus" Text="Architecture : en attente"/>
              <TextBlock x:Name="PayloadStatus" Text="Intégrité du paquet : en attente"/><TextBlock x:Name="DestinationStatus" Text="Dossier et accès : en attente"/>
              <TextBlock x:Name="SpaceStatus" Text="Espace disque et fichiers existants : en attente"/><TextBlock x:Name="ExistingStatus" Text="Installation existante : en attente"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="11">
              <TextBlock Text="CONNEXION DES CLÉS VIRTUELLES" Foreground="#2559C7" FontWeight="Bold" FontSize="11"/>
              <TextBlock x:Name="UsbIpStatus" Text="USB/IP : en attente"/><TextBlock x:Name="UsbIpHint" Classes="muted"/>
              <Button x:Name="InstallUsbDriverButton" Content="Choisir un pilote signé (.inf)…" Click="InstallUsbDriver_Click" HorizontalAlignment="Left"/>
              <CheckBox x:Name="DeferredUsbCheckBox" IsChecked="False" IsCheckedChanged="DeferredUsb_Changed"><TextBlock Text="Installer uniquement l’application ; je configurerai USB/IP plus tard." MaxWidth="490"/></CheckBox>
              <TextBlock Text="Sans pilote opérationnel et client USB/IP compatible, les clés virtuelles ne pourront pas être connectées. Aucun pilote n’est téléchargé automatiquement." Classes="muted"/>
            </StackPanel></Border>
            <TextBlock x:Name="DiagnosticSummary" FontWeight="SemiBold"/>
            <Button x:Name="RetryDiagnosticButton" Content="Relancer les vérifications" Click="RetryDiagnostic_Click" HorizontalAlignment="Left"/>
            <Button Content="Choisir un autre dossier…" Click="ConfigureDestination_Click" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel x:Name="OptionsPage" IsVisible="False" Spacing="18">
            <TextBlock Text="Personnaliser l’installation" Classes="heading"/><TextBlock Text="Les contrôles seront relancés pour le dossier choisi avant toute copie." Classes="muted"/>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="DOSSIER D’INSTALLATION" FontSize="11" FontWeight="Bold" Foreground="#2559C7"/>
              <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="FolderBox" Watermark="Chemin complet de destination" AutomationProperties.Name="Dossier d’installation"/><Button Grid.Column="1" Content="Parcourir…" Click="Browse_Click" Margin="10,0,0,0"/></Grid>
              <TextBlock Text="Choisissez un dossier vide ou une installation Nexora reconnue. Les dossiers système, partages réseau et liens redirigés sont refusés." Classes="muted"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="13"><CheckBox x:Name="DesktopCheckbox" Content="Créer un raccourci sur le Bureau" IsChecked="True"/><CheckBox x:Name="StartupCheckbox" Content="Lancer Nexora à l’ouverture de session" IsChecked="False"/><CheckBox x:Name="LaunchCheckbox" Content="Ouvrir Nexora à la fin de l’installation" IsChecked="True"/></StackPanel></Border>
            <TextBlock Text="Fermez Nexora avant une mise à jour de ce dossier. Les instances installées ailleurs ne sont pas arrêtées." Classes="muted"/>
          </StackPanel>
          <StackPanel x:Name="ProgressPage" IsVisible="False" Spacing="18">
            <TextBlock Text="Installation en cours" Classes="heading"/><TextBlock x:Name="InstallStatus" Text="Préparation…" Foreground="#52647C"/>
            <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Height="8" Foreground="#2559C7"/><TextBlock x:Name="PercentageText" Text="0 %" HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Gardez cette fenêtre ouverte jusqu’au résultat." Classes="muted"/>
            <Border Classes="card"><ScrollViewer Height="220"><TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#405572"/></ScrollViewer></Border>
          </StackPanel>
          <StackPanel x:Name="FinishedPage" IsVisible="False" Spacing="20">
            <TextBlock Text="Nexora est installé." Classes="heading"/><TextBlock Text="Les fichiers installés ont été vérifiés. Vous pouvez ouvrir Nexora ou consulter le compte rendu." FontSize="16" Foreground="#52647C"/>
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="INSTALLATION TERMINÉE" Foreground="#16704C" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="InstalledLocation"/><TextBlock x:Name="FinishedReadiness" Classes="muted"/></StackPanel></Border>
            <Button Content="Enregistrer le compte rendu…" Click="SaveReport_Click" HorizontalAlignment="Left"/><TextBlock Text="Le premier enregistrement et la première connexion FIDO2 restent à vérifier dans Nexora." Classes="muted"/>
          </StackPanel>
          <StackPanel x:Name="UninstallPage" IsVisible="False" Spacing="20">
            <TextBlock Text="Désinstaller Nexora" Classes="heading"/><TextBlock Text="Seuls les fichiers et raccourcis enregistrés par cet installateur seront supprimés." Foreground="#52647C"/>
            <Border Classes="card"><TextBlock Text="Votre coffre, vos identifiants et vos sauvegardes sont conservés." Foreground="#16704C"/></Border><TextBlock x:Name="UninstallStatus"/><Button x:Name="UninstallButton" Content="Désinstaller l’application" Click="Uninstall_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#DCE3EE" BorderThickness="0,1,0,0" Padding="24,16"><Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBlock Text="Nexora · Installation locale" Classes="muted" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="CancelButton" Content="Annuler" Click="Cancel_Click"/><Button Grid.Column="2" x:Name="BackButton" Content="Retour" Click="Back_Click" Margin="10,0,0,0"/><Button Grid.Column="3" x:Name="NextButton" Content="Continuer →" Classes="primary" Click="Next_Click" Margin="10,0,0,0" MinWidth="140"/>
    </Grid></Border>
  </Grid>
</Window>
