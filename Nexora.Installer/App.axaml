<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexora.Installer.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="Background" Value="#0B1020"/>
      <Setter Property="Foreground" Value="#F4F5FF"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#242E49"/>
      <Setter Property="Foreground" Value="#E8E9FF"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#364161"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8358EF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#9E7AFA"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#141E34"/>
      <Setter Property="BorderBrush" Value="#354361"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#DDE4FA"/>
    </Style>
  </Application.Styles>
</Application>
